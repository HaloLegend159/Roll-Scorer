nt/icons/7d1bb6a623f14959a47156ee71acfc3a.png","desc":"Dual strength barrel.\n  •  Increases range\n  •  Increases stability"},{"name":"Full Choke","icon":"/common/destiny2_content/icons/629246e67fc8690d56b5478b0262131a.png","desc":"Tightened barrel. Reduces projectile spread when aiming down sights at the cost of precision damage."},{"name":"Rifled Barrel","icon":"/common/destiny2_content/icons/79d5f1f469d3290cfb849f4b3e6fc16b.png","desc":"Ranged shotgun barrel.\n  •  Increases range\n  •  Greatly decreases handling speed"}]},{"label":"Magazine","weight":1,"perks":[{"name":"Accurized Rounds","icon":"/common/destiny2_content/icons/d85024478504205359c7fb52dbc4f6b6.png","desc":"This weapon can fire longer distances.\n  •  Increases range"},{"name":"Appended Mag","icon":"/common/destiny2_content/icons/d9f468cce26fe35d9db413e2f8451127.png","desc":"This weapon's magazine is built for higher capacity.\n  •  Increases magazine size"},{"name":"Tactical Mag","icon":"/common/destiny2_content/icons/f0e309a267b25279a871d182f8910bcc.png","desc":"This weapon has multiple tactical improvements.\n  •  Slightly increases stability\n  •  Increases reload speed\n  •  Slightly increases magazine size"},{"name":"Extended Mag","icon":"/common/destiny2_content/icons/66cfea124e24e73cca1ce6370b44ca7e.png","desc":"This weapon has a greatly increased magazine size, but reloads much slower.\n  •  Greatly increases magazine size\n  •  Greatly decreases reload speed\n  •  Increases airborne effectiveness"},{"name":"Steady Rounds","icon":"/common/destiny2_content/icons/6c6e1cc341487a8afd0b0c714a229255.png","desc":"This magazine is optimized for recoil control.\n  •  Greatly increases stability \n  •  Slightly decreases range\n  •  Increases airborne effectiveness"},{"name":"Alloy Magazine","icon":"/common/destiny2_content/icons/069170916c98748b7b3e33b80bd7d689.png","desc":"Faster reload when the magazine is nearly empty."},{"name":"Flared Magwell","icon":"/common/destiny2_content/icons/f95e67e4ff