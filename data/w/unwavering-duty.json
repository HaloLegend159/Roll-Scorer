{"id":"unwavering-duty","name":"Unwavering Duty","type":"Machine Gun","tier":"Legendary","icon":"/common/destiny2_content/icons/88ba6ad4e77283a76e16c2e89e76c22e.jpg","screenshot":"/common/destiny2_content/screenshots/906840740.jpg","columns":[{"label":"Barrel","weight":1,"perks":[{"name":"Arrowhead Brake","icon":"/common/destiny2_content/icons/8f7fb54687aa52a9c2595d90ce9c9417.png","desc":"Lightly vented barrel.\n  •  Greatly controls recoil\n  •  Increases handling speed"},{"name":"Chambered Compensator","icon":"/common/destiny2_content/icons/0b451cbccc7f11f6aec9c153e59474cb.png","desc":"Stable barrel attachment.\n  •  Increases stability\n  •  Moderately controls recoil\n  •  Slightly decreases handling speed"},{"name":"Corkscrew Rifling","icon":"/common/destiny2_content/icons/7730e1732ed7ef91afce50277639c493.png","desc":"Balanced barrel. \n  •  Slightly increases range and stability\n  •  Slightly increases handling speed"},{"name":"Extended Barrel","icon":"/common/destiny2_content/icons/d9e5e8fa07a84c29252b78b0e7b3106d.png","desc":"Weighty barrel extension.\n  •  Increases range\n  •  Decreases handling speed\n  •  Moderately controls recoil"},{"name":"Fluted Barrel","icon":"/common/destiny2_content/icons/260eba9dd149dbb94b1306c9ed4dd8db.png","desc":"Ultra-light barrel. \n  •  Greatly increases handling speed\n  •  Slightly increases stability"},{"name":"Full Bore","icon":"/common/destiny2_content/icons/40a4bdcf0f5a4e492927f9569eaf529d.png","desc":"Barrel optimized for distance.\n  •  Greatly increases range\n  •  Decreases stability\n  •  Slightly decreases handling speed"},{"name":"Hammer-Forged Rifling","icon":"/common/destiny2_content/icons/2b9eb6d4489cffc18c10223279198bcc.png","desc":"Durable ranged barrel.\n  •  Increases range"},{"name":"Polygonal Rifling","icon":"/common/destiny2_content/icons/7d7aaccee29cf450d4057a9de871cdc8.png","desc":"Barrel optimized for recoil reduction.\n  •  Increases stability"},{"name":"Smallbore","icon":"/common/destiny2_conten