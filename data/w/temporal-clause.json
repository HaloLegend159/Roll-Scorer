nt/icons/7d1bb6a623f14959a47156ee71acfc3a.png","desc":"Dual strength barrel.\n  •  Increases range\n  •  Increases stability"},{"name":"Full Choke","icon":"/common/destiny2_content/icons/629246e67fc8690d56b5478b0262131a.png","desc":"Tightened barrel. Reduces projectile spread when aiming down sights at the cost of precision damage."},{"name":"Rifled Barrel","icon":"/common/destiny2_content/icons/79d5f1f469d3290cfb849f4b3e6fc16b.png","desc":"Ranged shotgun barrel.\n  •  Increases range\n  •  Greatly decreases handling speed"}]},{"label":"Magazine","weight":1,"perks":[{"name":"Extended Mag","icon":"/common/destiny2_content/icons/66cfea124e24e73cca1ce6370b44ca7e.png","desc":"This weapon has a greatly increased magazine size, but reloads much slower.\n  •  Greatly increases magazine size\n  •  Greatly decreases reload speed\n  •  Increases airborne effectiveness"},{"name":"Alloy Magazine","icon":"/common/destiny2_content/icons/069170916c98748b7b3e33b80bd7d689.png","desc":"Faster reload when the magazine is nearly empty."},{"name":"Appended Mag","icon":"/common/destiny2_content/icons/d9f468cce26fe35d9db413e2f8451127.png","desc":"This weapon's magazine is built for higher capacity.\n  •  Increases magazine size"},{"name":"Armor-Piercing Rounds","icon":"/common/destiny2_content/icons/b311ef00478243e21e2a5eec3a59f9d8.png","desc":"Rounds cause extra damage to combatants' shields and overpenetrate targets. \n  •  Slightly increases range"},{"name":"High-Caliber Rounds","icon":"/common/destiny2_content/icons/9d1c49edb2d2b24c74067742c09fd5a5.png","desc":"Shots from this weapon knock the target back farther.\n  •  Slightly increases range"},{"name":"Ricochet Rounds","icon":"/common/destiny2_content/icons/0a494d0442b32aff8c30d8b2b53561bd.png","desc":"Rounds ricochet off hard surfaces. \n  •  Increases stability \n  •  Slightly increases range"},{"name":"Flared Magwell","icon":"/common/destiny2_content/icons/f95e67e4ff37466505d66d3fa1030782.png","desc":"Optimized for fast reloading.\n  •  Slightly increases stability\n  •  Greatly increases reload speed"},{"name":"Light Mag","icon":"/common/destiny2_content/icons/736b486ddb80beefacb4f09b5ad016eb.png","desc":"Improved reload and range.\n  •  Increases reload speed\n  •  Slightly increases range"},{"name":"Accurized Rounds","icon":"/common/destiny2_content/icons/d85024478504205359c7fb52dbc4f6b6.png","desc":"This weapon can fire longer distances.\n  •  Increases range"},{"name":"Tactical Mag","icon":"/common/destiny2_content/icons/f0e309a267b25279a871d182f8910bcc.png","desc":"This weapon has multiple tactical improvements.\n  •  Slightly increases stability\n  •  Increases reload speed\n  •  Slightly increases magazine size"},{"name":"Drop Mag","icon":"/common/destiny2_content/icons/9d19f0c349652f0285bb5f999307b8a1.png","desc":"Increases reload speed but reduces magazine size."},{"name":"Steady Rounds","icon":"/common/destiny2_content/icons/6c6e1cc341487a8afd0b0c714a229255.png","desc":"This magazine is optimized for recoil control.\n  •  Greatly increases stability \n  •  Slightly decreases range\n  •  Increases airborne effectiveness"}]},{"label":"Trait","weight":3,"perks":[{"name":"Fourth Time's the Charm","icon":"/common/destiny2_content/icons/a5edd4e751e1aa34bf8328a63b121e71.png","desc":"Rapidly landing precision hits will return two rounds to the magazine."},{"name":"Perpetual Motion","icon":"/common/destiny2_content/icons/8b9a4582016210723532907414759e69.png","desc":"This weapon gains bonus stability, handling, and reload speed while the wielder is in motion."},{"name":"Meganeura","icon":"/common/destiny2_content/icons/b5378713f840558b0641deb21bbe6c08.png","desc":"Precision final blows create an elemental damage explosion that deals more damage based on the number of rapid precision hits dealt beforehand."},{"name":"Incandescent","icon":"/common/destiny2_content/icons/22ed4a2cd5a0eb129a14ce77db49373f.png","desc":"Defeating a target spreads scorch to those nearby.\nMore powerful combatants and opposing Guardians cause scorch in a larger radius."},{"name":"Dynamic Sway Reduction","icon":"/common/destiny2_content/icons/36091de4dd029fb6e6ab95dbc612ff05.png","desc":"Improves accuracy and stability while continuously holding down the trigger."},{"name":"Enlightened Action","icon":"/common/destiny2_content/icons/cee13d00e65346dacc05562c80f537da.png","desc":"Dealing damage improves reload speed and handling."},{"name":"Demolitionist","icon":"/common/destiny2_content/icons/da009697110e06b65d6f827b3b6d5f70.png","desc":"Kills with this weapon generate grenade energy. Activating your grenade ability reloads this weapon from reserves."},{"name":"Quickdraw","icon":"/common/destiny2_content/icons/6893bb2c7ec7d13cb0d91ec9dd8b6500.png","desc":"This weapon can be drawn unbelievably fast."},{"name":"Firmly Planted","icon":"/common/destiny2_content/icons/379796d2e74676d3790f0bd485ea03a9.png","desc":"Increased accuracy, stability, and handling when firing while crouched."},{"name":"Pulse Monitor","icon":"/common/destiny2_content/icons/64642b7455e88ffde77be53ce7cb7c05.png","desc":"Automatically reloads the magazine and improves weapon handling when wounded—even when this weapon is stowed."},{"name":"Auto-Loading Holster","icon":"/common/destiny2_content/icons/e4262099a1c2cea78b48a6680c5248c9.png","desc":"The holstered weapon is automatically reloaded after a short period of time."},{"name":"Ambitious Assassin","icon":"/common/destiny2_content/icons/1f93b49c7f10b1be70083f913a3c5d63.png","desc":"Overflows the magazine based on the number of rapid kills before reloading."},{"name":"Genesis","icon":"/common/destiny2_content/icons/087a911353a3586f5346a1cf88d8de05.png","desc":"Breaking a combatant's shield with this weapon fills its magazine from reserves. Energy weapons regenerate ammo on hit when matching the damage type to the combatant's shield."}]},{"label":"Trait","weight":3,"perks":[{"name":"Surrounded","icon":"/common/destiny2_content/icons/979881b68ca7839267c9aef5aea2b0ce.png","desc":"This weapon gains bonus damage when three or more enemies are in close proximity."},{"name":"Rampage","icon":"/common/destiny2_content/icons/8976ead57430e4f5f8af1b3005de4f83.png","desc":"Kills with this weapon temporarily grant increased damage. Stacks 3x."},{"name":"Killing Tally","icon":"/common/destiny2_content/icons/a64f5d3e972ea35b1789f62999235083.png","desc":"Kills increase this weapon's damage until it is stowed or reloaded."},{"name":"Burning Ambition","icon":"/common/destiny2_content/icons/f7a2484668486f64020a612bd3dd5ab9.png","desc":"Dealing sustained damage scorches the target. Dealing damage to a scorched target inflicts scorch."},{"name":"Mega Kill Clip","icon":"/common/destiny2_content/icons/d033d35fb47c550e74bd023e61002ef0.png","desc":"Reloading after a final blow grants a period of increased damage. Additional final blows before reloading further increases the duration of the damage period."},{"name":"Target Lock","icon":"/common/destiny2_content/icons/72be46e05195a95ae1307a684f68456b.png","desc":"Damage increases the longer this weapon remains on a target."},{"name":"Adrenaline Junkie","icon":"/common/destiny2_content/icons/6f8bde03140b53e6dc583ada1aeaa51d.png","desc":"This weapon gains increased damage and handling from final blows with grenades or this weapon."},{"name":"Rangefinder","icon":"/common/destiny2_content/icons/74270d52bec24f1f5f4c987f5f37fce9.png","desc":"Aiming this weapon increases its effective range and zoom magnification. Increased projectile velocity while aiming Rocket Launchers, Grenade Launchers, and Bows."},{"name":"High-Impact Reserves","icon":"/common/destiny2_content/icons/33ed859a08f2ccf643a1ac3c7f201966.png","desc":"Rounds at the end of the magazine deal more damage."},{"name":"Hip-Fire Grip","icon":"/common/destiny2_content/icons/b481f0ed53a3ae0b31a370d115a06860.png","desc":"Increases accuracy, stability, and precision hit targeting when firing from the hip."},{"name":"Eye of the Storm","icon":"/common