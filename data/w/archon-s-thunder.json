nt/icons/7d1bb6a623f14959a47156ee71acfc3a.png","desc":"Dual strength barrel.\n  •  Increases range\n  •  Increases stability"},{"name":"Full Choke","icon":"/common/destiny2_content/icons/629246e67fc8690d56b5478b0262131a.png","desc":"Tightened barrel. Reduces projectile spread when aiming down sights at the cost of precision damage."},{"name":"Rifled Barrel","icon":"/common/destiny2_content/icons/79d5f1f469d3290cfb849f4b3e6fc16b.png","desc":"Ranged shotgun barrel.\n  •  Increases range\n  •  Greatly decreases handling speed"}]},{"label":"Magazine","weight":1,"perks":[{"name":"Accurized Rounds","icon":"/common/destiny2_content/icons/d85024478504205359c7fb52dbc4f6b6.png","desc":"This weapon can fire longer distances.\n  •  Increases range"},{"name":"Appended Mag","icon":"/common/destiny2_content/icons/d9f468cce26fe35d9db413e2f8451127.png","desc":"This weapon's magazine is built for higher capacity.\n  •  Increases magazine size"},{"name":"Tactical Mag","icon":"/common/destiny2_content/icons/f0e309a267b25279a871d182f8910bcc.png","desc":"This weapon has multiple tactical improvements.\n  •  Slightly increases stability\n  •  Increases reload speed\n  •  Slightly increases magazine size"},{"name":"Extended Mag","icon":"/common/destiny2_content/icons/66cfea124e24e73cca1ce6370b44ca7e.png","desc":"This weapon has a greatly increased magazine size, but reloads much slower.\n  •  Greatly increases magazine size\n  •  Greatly decreases reload speed\n  •  Increases airborne effectiveness"},{"name":"Steady Rounds","icon":"/common/destiny2_content/icons/6c6e1cc341487a8afd0b0c714a229255.png","desc":"This magazine is optimized for recoil control.\n  •  Greatly increases stability \n  •  Slightly decreases range\n  •  Increases airborne effectiveness"},{"name":"Alloy Magazine","icon":"/common/destiny2_content/icons/069170916c98748b7b3e33b80bd7d689.png","desc":"Faster reload when the magazine is nearly empty."},{"name":"Flared Magwell","icon":"/common/destiny2_content/icons/f95e67e4ff37466505d66d3fa1030782.png","desc":"Optimized for fast reloading.\n  •  Slightly increases stability\n  •  Greatly increases reload speed"},{"name":"Ricochet Rounds","icon":"/common/destiny2_content/icons/0a494d0442b32aff8c30d8b2b53561bd.png","desc":"Rounds ricochet off hard surfaces. \n  •  Increases stability \n  •  Slightly increases range"},{"name":"Light Mag","icon":"/common/destiny2_content/icons/736b486ddb80beefacb4f09b5ad016eb.png","desc":"Improved reload and range.\n  •  Increases reload speed\n  •  Slightly increases range"},{"name":"Armor-Piercing Rounds","icon":"/common/destiny2_content/icons/b311ef00478243e21e2a5eec3a59f9d8.png","desc":"Rounds cause extra damage to combatants' shields and overpenetrate targets. \n  •  Slightly increases range"},{"name":"Drop Mag","icon":"/common/destiny2_content/icons/9d19f0c349652f0285bb5f999307b8a1.png","desc":"Increases reload speed but reduces magazine size."},{"name":"Assault Mag","icon":"/common/destiny2_content/icons/953cfdeb2703978b1ab449b991b98989.png","desc":"This shotgun's magazine is optimized for quick combat.\n  •  Greatly increases stability\n  •  Increases rate of fire"},{"name":"High-Caliber Rounds","icon":"/common/destiny2_content/icons/9d1c49edb2d2b24c74067742c09fd5a5.png","desc":"Shots from this weapon knock the target back farther.\n  •  Slightly increases range"}]},{"label":"Trait","weight":3,"perks":[{"name":"Air Trigger","icon":"/common/destiny2_content/icons/21341179175df69bcd71b8c4f2d2ebe6.png","desc":"Increased ammo generation. When airborne, accuracy and reload speed are increased but target acquisition is decreased."},{"name":"Enlightened Action","icon":"/common/destiny2_content/icons/cee13d00e65346dacc05562c80f537da.png","desc":"Dealing damage improves reload speed and handling."},{"name":"Dynamic Sway Reduction","icon":"/common/destiny2_content/icons/36091de4dd029fb6e6ab95dbc612ff05.png","desc":"Improves accuracy and stability while continuously holding down the trigger."},{"name":"Envious Assassin","icon":"/common/destiny2_content/icons/bf7fccf6de8ee6d2e9e6285c004a4758.png","desc":"Defeating targets with other weapons before drawing this one transfers ammo to the magazine from reserves. This effect can overflow the magazine based on the number of targets defeated."},{"name":"Fourth Time's the Charm","icon":"/common/destiny2_content/icons/a5edd4e751e1aa34bf8328a63b121e71.png","desc":"Rapidly landing precision hits will return two rounds to the magazine."},{"name":"Rimestealer","icon":"/common/destiny2_content/icons/b88380f8b364c2743d53f12d4d98e273.png","desc":"Destroying a Stasis crystal or defeating a frozen target with this weapon grants you Frost Armor."},{"name":"High-Impact Reserves","icon":"/common/destiny2_content/icons/33ed859a08f2ccf643a1ac3c7f201966.png","desc":"Rounds at the end of the magazine deal more damage."},{"name":"Mulligan","icon":"/common/destiny2_content/icons/8ca9b9caef4c4c5c0c19d3be25be3755.png","desc":"Missing a shot has a chance to return ammo directly to the magazine."},{"name":"Field Prep","icon":"/common/destiny2_content/icons/4ee1ecaead6fe2de1a2cab07f8b7be3f.png","desc":"Increases ammo generation. Faster reload, stow, and ready speed when you're crouching."},{"name":"Rangefinder","icon":"/common/destiny2_content/icons/74270d52bec24f1f5f4c987f5f37fce9.png","desc":"Aiming this weapon increases its effective range and zoom magnification. Increased projectile velocity while aiming Rocket Launchers, Grenade Launchers, and Bows."},{"name":"Quickdraw","icon":"/common/destiny2_content/icons/6893bb2c7ec7d13cb0d91ec9dd8b6500.png","desc":"This weapon can be drawn unbelievably fast."},{"name":"Killing Wind","icon":"/common/destiny2_content/icons/db2aa71ff6d808929bb0e668dcf0822e.png","desc":"Final blows grant increased mobility, weapon range, and handling for a short duration."},{"name":"Surplus","icon":"/common/destiny2_content/icons/a4c054c3547840300b9ce7ef11b7b6fc.png","desc":"Increases handling, reload speed, and stability for ea