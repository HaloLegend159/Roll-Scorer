{"id":"dead-man-s-tale","name":"Dead Man's Tale","type":"Scout Rifle","tier":"Exotic","icon":"/common/destiny2_content/icons/cfc2c246cfd404d749fffbfe3ae3dfec.jpg","screenshot":"/common/destiny2_content/screenshots/2188764214.jpg","columns":[{"label":"Barrel","weight":1,"perks":[{"name":"Corkscrew Rifling","icon":"/common/destiny2_content/icons/7730e1732ed7ef91afce50277639c493.png","desc":"Balanced barrel. \n  •  Slightly increases range and stability\n  •  Slightly increases handling speed"},{"name":"Arrowhead Brake","icon":"/common/destiny2_content/icons/8f7fb54687aa52a9c2595d90ce9c9417.png","desc":"Lightly vented barrel.\n  •  Greatly controls recoil\n  •  Increases handling speed"},{"name":"Polygonal Rifling","icon":"/common/destiny2_content/icons/7d7aaccee29cf450d4057a9de871cdc8.png","desc":"Barrel optimized for recoil reduction.\n  •  Increases stability"},{"name":"Chambered Compensator","icon":"/common/destiny2_content/icons/0b451cbccc7f11f6aec9c153e59474cb.png","desc":"Stable barrel attachment.\n  •  Increases stability\n  •  Moderately controls recoil\n  •  Slightly decreases handling speed"},{"name":"Smallbore","icon":"/common/destiny2_content/icons/7d1bb6a623f14959a47156ee71acfc3a.png","desc":"Dual strength barrel.\n  •  Increases range\n  •  Increases stability"},{"name":"Full Bore","icon":"/common/destiny2_content/icons/40a4bdcf0f5a4e492927f9569eaf529d.png","desc":"Barrel optimized for distance.\n  •  Greatly increases range\n  •  Decreases stability\n  •  Slightly decreases handling speed"},{"name":"Extended Barrel","icon":"/common/destiny2_content/icons/d9e5e8fa07a84c29252b78b0e7b3106d.png","desc":"Weighty barrel extension.\n  •  Increases range\n  •  Decreases handling speed\n  •  Moderately controls recoil"},{"name":"Fluted Barrel","icon":"/common/destiny2_content/icons/260eba9dd149dbb94b1306c9ed4dd8db.png","desc":"Ultra-light barrel. \n  •  Greatly increases handling speed\n  •  Slightly increases stability"},{"name":"Hammer-Forged Rifling","icon":"/common/destiny2_content/icons/2b9eb6d4489cffc18c10223279198bcc.png","desc":"Durable ranged barrel.\n  •  Increases range"},{"name":"Full Choke","icon":"/common/destiny2_content/icons/629246e67fc8690d56b5478b0262131a.png","desc":"Tightened barrel. Reduces projectile spread when aiming down sights at the cost of precision damage."},{"name":"Rifled Barrel","icon":"/common/destiny2_content/icons/79d5f1f469d3290cfb849f4b3e6fc16b.png","desc":"Ranged shotgun barrel.\n  •  Increases range\n  •  Greatly decreases handling speed"}]},{"label":"Magazine","weight":1,"perks":[{"name":"Accurized Rounds","icon":"/common/destiny2_content/icons/d85024478504205359c7fb52dbc4f6b6.png","desc":"This weapon can fire longer distances.\n  •  Increases range"},{"name":"Steady Rounds","icon":"/common/destiny2_content/icons/6c6e1cc341487a8afd0b0c714a229255.png","desc":"This magazine is optimized for recoil control.\n  •  Greatly increases stability \n  •  Slightly decreases range\n  •  Increases airborne effectiveness"},{"name":"Flared Magwell","icon":"/common/destiny2_content/icons/f95e67e4ff37466505d66d3fa1030782.png","desc":"Optimized for fast reloading.\n  •  Slightly increases stability\n  •  Greatly increases reload speed"},{"name":"Armor-Piercing Rounds","icon":"/common/destiny2_content/icons/b311ef00478243e21e2a5eec3a59f9d8.png","desc":"Rounds cause extra damage to combatants' shields and overpenetrate targets. \n  •  Slightly increases range"},{"name":"High-Caliber Rounds","icon":"/common/destiny2_content/icons/9d1c49edb2d2b24c74067742c09fd5a5.png","desc":"Shots from this weapon knock the target back farther.\n  •  Slightly increases range"},{"name":"Ricochet Rounds","icon":"/common/destiny2_content/icons/0a494d0442b32aff8c30d8b2b53561bd.png","desc":"Rounds ricochet off hard surfaces. \n  •  Increases stability \n  •  Slightly increases range"},{"name":"Light Mag","icon":"/common/destiny2_content/icons/736b486ddb80beefacb4f09b5ad016eb.png","desc":"Improved reload and range.\n  •  Increases reload speed\n  •  Slightly increases range"}]},{"label":"Trait","weight":3,"perks":[{"name":"Outlaw","icon":"/common/destiny2_content/icons/382df469a091c33e190ee583b64923e8.png","desc":"Precision kills greatly decrease reload time."},{"name":"Fourth Time's the Charm","icon":"/common/destiny2_content/icons/a5edd4e751e1aa34bf8328a63b121e71.png","desc":"Rapidly landing precision hits will return two rounds to the magazine."},{"name":"Compulsive Reloader","icon":"/common/destiny2_content/icons/ef5843dfe8134c7385945216ece2bb06.png","desc":"Grants increased reload speed when close to full magazine."},{"name":"Killing Wind","icon":"/common/destiny2_content/icons/db2aa71ff6d808929bb0e668dcf0822e.png","desc":"Final blows grant increased mobility, weapon range, and handling for a short duration."},{"name":"Moving Target","icon":"/common/destiny2_content/icons/40b591eae7f122fdf1cfca21fc6f6c0f.png","desc":"Increased movement speed and target acquisition when moving while aiming down sights."},{"name":"Vorpal Weapon","icon":"/common/destiny2_content/icons/bc5130b227ee577f2678ec2d2c97bf4a.png","desc":"Increased damage against bosses, vehicles, and Guardians with their Super active."},{"name":"Rapid Hit","icon":"/common/destiny2_content/icons/de22847fa94634a487758041887bcdaa.png","desc":"Rapid precision hits temporarily increase stability and reload speed."},{"name":"Shoot to Loot","icon":"/common/destiny2_content/icons/e8c6e23afe3c4215f0dc0c2941500c28.png","desc":"Shooting an Orb of Power picks it up. Shooting an ammo brick picks it up and automatically reloads all of your equipped weapons from reserves."},{"name":"Subsistence","icon":"/common/destiny2_content/icons/eaa8f4295a71bf47df7ffd8599f7af4d.png","desc":"Defeating targets partially reloads the magazine from reserves."},{"name":"Snapshot Sights","icon":"/common/destiny2_content/icons/ce16c9e2cbd73bb548af3e15bdfc7177.png","desc":"Faster time to aim down sights."},{"name":"Transformative","icon":"/common/destiny2_content/icons/ef1a8374c931321694d6d3d0d3e96247.png","desc":"Future drops of this weapon will have random rolls."}]},{"label":"Stock","weight":1,"perks":[{"name":"Hand-Laid Stock","icon":"/common/destiny2_content/icons/11fe23229c61287c89916f094b26652f.png","desc":"This weapon is optimized for recoil control.\n  •  Increases stability"},{"name":"Short-Action Stock","icon":"/common/destiny2_content/icons/47f90d3f25a517166933f2b4eb38e9aa.png","desc":"This weapon is especially easy to grip.\n  •  Greatly increases handling speed"},{"name":"Composite Stock","icon":"/common/destiny2_content/icons/7c616b3d2d0e97bf8948b1371b3007bb.png","desc":"This weapon has a versatile dual-purpose stock.\n  •  Slightly increases stability\n  •  Slightly increases handling speed"},{"name":"Fitted Stock","icon":"/common/destiny2_content/icons/a23363ab49857b303f2cfa238fe5045c.png","desc":"This stock makes the weapon stable but heavy\n  •  Increases stability\n  •  Moderately controls recoil\n  •  Slightly decreases handling speed"}]},{"label":"Perk","weight":1,"perks":[{"name":"Dark-Forged Trigger","icon":"/common/destiny2_content/icons/041974d03e7be809ab82f65587010ee2.png","desc":"Removes hipfire accuracy penalties while increasing rate of fire. At maximum stacks of Cranial Spike, hipfiring deals increased damage."}]}],"notes":["Inspired by @PodvsEnemies Podcast vs Enemies episode 78 (https://open.spotify.com/episode/5KOQQ9QtvSEhRVb4vjeO3B?si=8c4784e02b87424e) with @Saint_Kabr and @CourtProjects. First-choice PvE pick for add clearing Minor Spec enemies in end-game content. Dead Man's Tale, in it's revised form may still be thought of as primarily a PvP weapon, but it can still put in some work in PvE. Start with Fluted Barrel - handling and stability are always good to have. As the mag perk Flared Magwell really is the best choice - with reloading two shots at a time, it can feel quite slow - but if you're happy with reload speed, choose from your preferred combat effect mag. In the trait slot, you could choose Vorpal Weapon for the +20% damage against Majors and Bosses, or Shoot to Loot to safely pick up ammo and orbs of power from cover. As the stock perk, Hand-Laid Stock is a nice boost to Handling, or Fitted Stock takes the recoil to 100 and adds stability, at the cost of a little handling.","Inspired by Destiny Massive Breakdowns from Podast 198. PvP first choice roll.","Inspired by Destiny Massive Breakdowns from Podast 198. PvE first choice roll.","Inspired by Destiny Massive Breakdowns from Podast 198. PvP/PvE backup roll.","Inspired by Destiny Massive Breakdowns from Podast 198. PvP backup roll.","Inspired by Destiny Massive Breakdowns from Podast 198. PvE backup roll."],"estimated":null,"modes":{"all":{"rolls":[[4,13,19,29],[4,13,19,31],[4,16,21,31],[4,16,22,31],[7,13,19,29],[7,13,19,31],[7,13,23,29],[7,14,23,29],[7,16,21,31],[7,16,22,31],[0,13,19,29],[0,13,19,31],[0,16,18,32],[0,16,23,32],[0,16,26,32],[0,17,19,29],[0,17,19,31],[2,13,19,29],[2,13,19,31],[2,16,21,31],[2,16,22,31],[3,16,18,31],[3,16,21,31],[3,16,22,31],[3,16,23,31],[3,16,26,31],[4,11,21,30],[4,11,21,31],[4,11,22,30],[4,11,22,31],[4,11,27,30],[4,11,27,31],[4,13,18,29],[4,13,18,30],[4,13,18,31],[4,13,19,30],[4,13,23,29],[4,13,23,30],[4,13,23,31],[4,14,18,29],[4,14,18,30],[4,14,18,31],[4,14,19,29],[4,14,19,30],[4,14,19,31],[4,14,23,29],[4,14,23,30],[4,14,23,31],[4,15,21,30],[4,15,21,31],[4,15,22,30],[4,15,22,31],[4,15,27,30],[4,15,27,31],[4,16,21,30],[4,16,22,30],[4,16,27,30],[4,16,27,31],[4,17,19,29],[4,17,19,31],[7,11,21,30],[7,11,21,31],[7,11,22,30],[7,11,22,31],[7,11,27,30],[7,11,27,31],[7,13,18,29],[7,13,18,30],[7,13,18,31],[7,13,19,30],[7,13,23,30],[7,13,23,31],[7,13,23,32],[7,14,18,29],[7,14,18,30],[7,14,18,31],[7,14,19,29],[7,14,19,30],[7,14,19,31],[7,14,23,30],[7,14,23,31],[7,15,21,30],[7,15,21,31],[7,15,22,30],[7,15,22,31],[7,15,23,29],[7,15,27,30],[7,15,27,31],[7,16,21,30],[7,16,22,30],[7,16,23,32],[7,16,27,30],[7,16,27,31],[7,17,19,29],[7,17,19,31],[0,13,18,29],[0,13,18,3