{"id":"badlander","name":"Badlander","type":"Shotgun","tier":"Legendary","icon":"/common/destiny2_content/icons/4b4830246eebff3d9fb234e8cb26ce58.jpg","screenshot":"/common/destiny2_content/screenshots/1327264046.jpg","columns":[{"label":"Barrel","weight":1,"perks":[{"name":"Rifled Barrel","icon":"/common/destiny2_content/icons/79d5f1f469d3290cfb849f4b3e6fc16b.png","desc":"Ranged shotgun barrel.\n  •  Increases range\n  •  Greatly decreases handling speed"},{"name":"Smoothbore","icon":"/common/destiny2_content/icons/893c134549afba522b3cbd2e43fdf4fa.png","desc":"Smooth shotgun barrel. Greatly increases range at the cost of more projectile spread."},{"name":"Smallbore","icon":"/common/destiny2_content/icons/7d1bb6a623f14959a47156ee71acfc3a.png","desc":"Dual strength barrel.\n  •  Increases range\n  •  Increases stability"},{"name":"Barrel Shroud","icon":"/common/destiny2_content/icons/d9e5e8fa07a84c29252b78b0e7b3106d.png","desc":"Balanced shotgun barrel.\n  •  Increases stability\n  •  Increases handling speed"},{"name":"Corkscrew Rifling","icon":"/common/destiny2_content/icons/7730e1732ed7ef91afce50277639c493.png","desc":"Balanced barrel. \n  •  Slightly increases range and stability\n  •  Slightly increases handling speed"},{"name":"Full Choke","icon":"/common/destiny2_content/icons/629246e67fc8690d56b5478b0262131a.png","desc":"Tightened barrel. Reduces projectile spread when aiming down sights at the cost of precision damage."}]},{"label":"Magazine","weight":1,"perks":[{"name":"Appended Mag","icon":"/common/destiny2_content/icons/d9f468cce26fe35d9db413e2f8451127.png","desc":"This weapon's magazine is built for higher capacity.\n  •  Increases magazine size"},{"name":"Tactical Mag","icon":"/common/destiny2_content/icons/f0e309a267b25279a871d182f8910bcc.png","desc":"This weapon has multiple tactical improvements.\n  •  Slightly increases stability\n  •  Increases reload speed\n  •  Slightly increases magazine size"},{"name":"Extended Mag","icon":"/common/destiny2_cont